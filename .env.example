# ───────────────────────────────────────────────────────────
# Turso (Base de données SQLite serverless)
# ───────────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://arts-et-toiles-nom-utilisateur.turso.io
TURSO_AUTH_TOKEN=ta-token-d-authentification

# ───────────────────────────────────────────────────────────
# Cloudflare R2 (Stockage d'images)
# ───────────────────────────────────────────────────────────
R2_ACCOUNT_ID=ton-account-id-cloudflare
R2_ACCESS_KEY_ID=ta-clef-acces
R2_SECRET_ACCESS_KEY=ta-clef-secrete
R2_BUCKET_NAME=arts-et-toiles-images
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ───────────────────────────────────────────────────────────
# JWT (Admin)
# ───────────────────────────────────────────────────────────
JWT_SECRET=une-chaine-secrete-pour-les-tokens